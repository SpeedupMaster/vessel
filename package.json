{
  "name": "vessel",
  "version": "1.0.10",
  "private": true,
  "description": "Vessel — Lean Docker Compose Self-Hosted Application Management Hub",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./web\" --filter \"./server\" dev",
    "build": "pnpm --filter \"./web\" build && pnpm --filter \"./server\" build",
    "start": "pnpm --filter \"./server\" start",
    "test": "pnpm --filter \"./server\" build && node --test server/tests/*.test.cjs",
    "check": "pnpm test && pnpm build"
  },
  "keywords": [
    "vessel",
    "docker",
    "compose",
    "caddy",
    "ssl",
    "r2",
    "ghcr",
    "hallmark",
    "gsap"
  ],
  "author": "Antigravity",
  "license": "MIT"
}
